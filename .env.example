# Umami analytics (self-hosted). Read at BUILD time by Vite — set these in the
# build environment, not at runtime. Analytics stays off entirely when
# VITE_UMAMI_HOST or VITE_UMAMI_WEBSITE_ID is unset, and in dev builds.
VITE_UMAMI_HOST=umami.apps.janjaap.de
VITE_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000

# Optional — default shown.
# Renamed script.js on the instance (adblock evasion).
# VITE_UMAMI_SCRIPT=script.js
