# Matomo analytics (self-hosted). Read at BUILD time by Vite — set these in the
# build environment, not at runtime. Analytics stays off entirely when
# VITE_MATOMO_HOST is unset, and in dev builds.
VITE_MATOMO_HOST=analytics.example.org

# Optional — defaults shown.
# VITE_MATOMO_SITE_ID=1
# Renamed matomo.js / matomo.php on the instance (adblock evasion).
# VITE_MATOMO_SCRIPT=not_matomo.js
# VITE_MATOMO_TRACKER=matomo.php
