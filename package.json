{
  "name": "attraccess-homepage",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "preview": "pnpm --filter web preview",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter web test",
    "check:links": "pnpm --filter web check:links",
    "screenshots": "pnpm --filter web screenshots",
    "og": "pnpm --filter web og",
    "film:studio": "pnpm --filter hero-film studio",
    "film:export": "apps/hero-film/film/scripts/export.sh"
  }
}
